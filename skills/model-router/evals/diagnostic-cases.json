  {
    "id": "code_review",
    "instructions": "For each snippet return exactly the candidate finding IDs that demonstrate a violation of its explicit contract. Do not add findings outside that contract. An empty array means no violation. Candidate IDs are labels, not assertions.",
    "cases": [
      {
        "id": "integer_guard",
        "source": "Contract: accept only nonnegative JSON integers; reject booleans.\nCode: def valid(x): return isinstance(x, int) and x >= 0",
        "candidates": [
          "bool_is_int",
          "negative_accepted",
          "input_mutation"
        ]
      },
      {
        "id": "json_guard",
        "source": "Contract: reject duplicate object keys and every non-finite number, including exponent overflow.\nCode: def parse(text): return json.loads(text, parse_constant=lambda s: (_ for _ in ()).throw(ValueError(s)))",
        "candidates": [
          "duplicate_keys",
          "exponent_overflow",
          "valid_null_rejected"
        ]
      },
      {
        "id": "reconcile_lock",
        "source": "Contract: a concurrent cancellation cannot be overwritten by a stale successful proposal.\nCode:\n current = read_receipt()\n with lock:\n  proposal = preserve_cancel(current, proposal)\n  atomic_replace(proposal)",
        "candidates": [
          "stale_reconcile",
          "non_atomic_replace",
          "unbounded_output"
        ]
      },
      {
        "id": "normalization",
        "source": "Contract: input is a list of strings; return a new lexicographically sorted list with duplicates removed; do not mutate input.\nCode: def normalize(ids): return sorted(set(ids))",
        "candidates": [
          "input_mutation",
          "duplicates_retained",
          "wrong_order"
        ]
      },
      {
        "id": "verdict",
        "source": "Contract: only a single bare verdict line in the last === REVIEW === section counts; quoted/scaffold text is not authority.\nCode: def verdict(text): return re.search(r\"verdict: (PASS|FAIL)\", text).group(1)",
        "candidates": [
          "unanchored_verdict",
          "wrong_model",
          "digest_mismatch"
        ]
      },
      {
        "id": "permissions",
        "source": "Contract: the dispatched child runs under the same UID as the supervisor and must be unable to overwrite receipt files.\nCode:\n os.chmod(receipt_dir, 0o700)\n subprocess.run(child_argv)",
        "candidates": [
          "same_uid_writable",
          "different_uid_writable",
          "no_process_group"
        ]
      }
    ],
    "expected": {
      "integer_guard": [
        "bool_is_int"
      ],
      "json_guard": [
        "duplicate_keys",
        "exponent_overflow"
      ],
      "reconcile_lock": [
        "stale_reconcile"
      ],
      "normalization": [],
      "verdict": [
        "unanchored_verdict"
      ],
      "permissions": [
        "same_uid_writable"
      ]
    },
    "answer_order": "set"
  },
